# Copy this file to ".env" and fill in real values. Never commit ".env".

# --- Server ---
# Port/host the HTTP server listens on.
PORT=8080
HOST=0.0.0.0
# Set to "true" only when serving over HTTPS, so the session cookie is sent
# with the Secure flag. Leave unset/false for local HTTP.
COOKIE_SECURE=false

# --- Telegram bot (optional) ---
# Leave TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID empty to disable Telegram entirely.
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Admin (Head IT) chat id — default recipient that sees every ticket.
TELEGRAM_CHAT_ID=
# Username recorded as the actor for status changes made via Telegram.
TELEGRAM_ACTING_USERNAME=safari

# Optional role-specific chat ids. Each may be a comma-separated list of ids.
# Tickets for a role fall back to the admin chat if its id isn't set.
TELEGRAM_CHAT_ID_CRM=
TELEGRAM_CHAT_ID_TELEPHONY=

# Optional IT agents the admin can forward tickets to: "chatId:Name,chatId:Name".
# Falls back to a built-in default list if unset.
TELEGRAM_IT_AGENTS=
